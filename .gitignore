# =====================================================================
# CANDIDLY AI VOICE INTERVIEW PLATFORM - .gitignore
# =====================================================================

# Environment & Credentials (NEVER commit secrets)
.env
.env.*
.env.local
!.env.example
*.pem
*.key
*.crt

# Virtual Environments
.venv/
venv/
ENV/
env/

# Python Bytecode & Packaging
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Node & Frontend Build Outputs
node_modules/
frontend/node_modules/
frontend/dist/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing, Cache & Ephemeral Benchmark Results
.pytest_cache/
.coverage
.coverage.*
htmlcov/
docs/matrix_cache.json
docs/r3_matrix_results.json
docs/*.cache.json

# Local Media, Audio & Uploads
audio_cache/
recordings/
uploads/
tmp/
temp/
debug/
data/
*.log
logs/

# Knowledge Graph & Assistant Artifacts
graphify-out/
.graphify*
.claude/
CLAUDE.md
.gemini/
DATABASE_TABLES_AND_LLM_PIPELINE.md

# Operating System & IDE Artifacts
.DS_Store
**/.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~
*.bak

# Root temporary image crops & debugging captures
/*.png
/*.jpg
/*.jpeg

# SwiftPM build artifacts (Apple STT helper) — regenerable via scripts/build_apple_stt.sh
native/apple_stt/.build/
