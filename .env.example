# =====================================================================
# CANDIDLY AI VOICE INTERVIEW PLATFORM - ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your actual credentials.
# =====================================================================

ADMIN_API_KEY=your_admin_api_key_here

# ---------------------------------------------------------------------
# Primary LLM: Google Gemini (Automatic 3-Key Rotation)
# ---------------------------------------------------------------------
GEMINI_API_KEY1=your_first_gemini_api_key
GEMINI_API_KEY2=your_second_gemini_api_key
GEMINI_API_KEY3=your_third_gemini_api_key
GEMINI_API_KEY=your_fallback_gemini_api_key

# Gemini Models
GEMINI_MODEL_PLAN=gemini-2.5-pro
GEMINI_MODEL_LIVE=gemini-2.5-flash-lite
GEMINI_MODEL_JUDGE=gemini-2.5-flash

# ---------------------------------------------------------------------
# Backup LLM Providers (OpenRouter & NVIDIA NIM)
# ---------------------------------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# ---------------------------------------------------------------------
# Database Configuration
# ---------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/candidly
# TEST_DATABASE_URL is required to run the test suite. Database name MUST contain 'test'.
# The test runner will refuse to run if this is unset or points to a non-test database.
TEST_DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/candidly_test

# ---------------------------------------------------------------------
# Failover & Runtime Flags
# ---------------------------------------------------------------------
AI_FAILOVER_ENABLED=true
AI_FAILOVER_CANDIDATE_DATA=false
INTERVIEW_RECORDING_ENABLED=false
DEBUG_TURN_TRACE=0
DEBUG_AUDIO_CAPTURE=0

# ---------------------------------------------------------------------
# Live Interview Engine (v2) Runtime Flags
# ---------------------------------------------------------------------
# Speculative lookahead runs the plan-bounded selector ~800ms before commit and
# reuses the decision when the committed answer hash matches exactly. Set to 1
# to disable it (every decision becomes a fresh LLM call after commit).
INTERVIEW_DISABLE_PLAN_SPECULATION=0
# Seconds before an abandoned (disconnected) session is finalized automatically.
INTERVIEW_DISCONNECT_GRACE_SECONDS=120
